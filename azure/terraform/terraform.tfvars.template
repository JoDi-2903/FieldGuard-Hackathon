# Copy this file to `terraform.tfvars` and fill in real values.
# `terraform.tfvars` is gitignored (contains secrets) — this .template is the only
# version committed. Do NOT put real secrets in this template.

# Required: the subscription to deploy into.
subscription_id = "00000000-0000-0000-0000-000000000000"

# Optional overrides (defaults shown).
project         = "fieldguard"
location        = "westeurope"
openai_location = "swedencentral" # must offer the chosen model/version
swa_location    = "westus2"       # SWA Free regions: westus2, eastus2, centralus, eastasia

# Optional: pin an Azure OpenAI model version that is GA in openai_location.
# openai_model_version = "2025-08-07"
# openai_capacity      = 10

# Ingest shared secret.
# The live Arduino and the demo seeding both authenticate to /api/ingest with this.
# When deploy_app = true (the default) it MUST be set here so the automatic deploy can
# seed and so devices can post; setting it here injects it via app settings but also
# writes it into terraform.tfstate (plaintext on disk).
# To keep it out of state: set deploy_app = false, leave this empty, and set the secret
# out-of-band after apply:
#   az functionapp config appsettings set -g <rg> -n <func> --settings INGEST_SHARED_SECRET=<secret>
ingest_secret = ""

# --- Automatic application deployment (see deploy.tf; defaults shown) ---
# deploy_app     = true          # also publish function + frontend + seed fields on apply
# seed_demo_data = true          # also stream demo telemetry + first scores
# live_devices   = ["box-01"]    # real hardware excluded from demo seeding (SEED_SKIP_DEVICES)
