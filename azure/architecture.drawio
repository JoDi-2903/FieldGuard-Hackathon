<mxfile host="Electron" agent="FieldGuard">
  <diagram name="FieldGuard Architecture" id="fieldguard-arch">
    <mxGraphModel dx="1214" dy="942" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="860" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;fontColor=#1b3a5b;" value="FieldGuard: From Field Sensors to Risk Dashboard" vertex="1">
          <mxGeometry height="36" width="820" x="40" y="24" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" value="Sensor boxes measure weather and soil. The cloud scores crop disease risk with AI every 20 minutes. Officers see fields ranked by risk, and each box shows a traffic light." vertex="1">
          <mxGeometry height="22" width="1000" x="40" y="60" as="geometry" />
        </mxCell>
        <mxCell id="fieldZone" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;fontStyle=1;fontSize=14;fontColor=#2d5a1b;arcSize=4;" value="In the field (Arduino box)" vertex="1">
          <mxGeometry height="510" width="270" x="40" y="130" as="geometry" />
        </mxCell>
        <mxCell id="cloudZone" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef5fc;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;fontStyle=1;fontSize=14;fontColor=#1b3a5b;arcSize=3;" value="Azure cloud" vertex="1">
          <mxGeometry height="510" width="840" x="350" y="130" as="geometry" />
        </mxCell>
        <mxCell id="sensors" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;align=center;" value="Sensors&#xa;temperature, humidity, rain, soil" vertex="1">
