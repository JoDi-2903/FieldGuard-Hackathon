        <mxCell id="scorer" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;align=center;" value="Risk scoring (every 20 min)&#xa;weather rule plus AI advice&#xa;turns readings into a risk level" vertex="1">
