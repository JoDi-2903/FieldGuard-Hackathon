        <mxCell id="fieldbox" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;fontStyle=1;align=center;" value="Field box&#xa;sends readings over WiFi" vertex="1">
          <mxGeometry height="90" width="220" x="65" y="320" as="geometry" />
        </mxCell>
        <mxCell id="led" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" value="Traffic light&#xa;green, yellow, red" vertex="1">
          <mxGeometry height="90" width="220" x="65" y="470" as="geometry" />
        </mxCell>
        <mxCell id="eSensor" edge="1" parent="1" source="sensors" style="endArrow=block;html=1;rounded=1;strokeColor=#82b366;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="fieldbox" value="">
