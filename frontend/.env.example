# Local development only.
#
# In production the Azure Static Web App serves this app and proxies /api to the
# linked Function App (same origin), so NONE of these are needed when deployed.

# Where `npm run dev` proxies /api requests. Defaults to the local Functions host.
# Point it at the deployed Function App to develop the UI against real data:
#   VITE_API_PROXY=https://fieldguard-func-xxxxxx.azurewebsites.net
VITE_API_PROXY=http://localhost:7071

# Optional: bypass the /api proxy and call an absolute API base directly from the
# browser (the backend must then allow this origin via CORS).
# VITE_API_URL=https://fieldguard-func-xxxxxx.azurewebsites.net/api
